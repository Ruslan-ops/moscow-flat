{
  "manifest_version": 3,
  "name": "MoscowFlatCollector",
  "version": "0.5.0",
  "description": "Собирает данные объявлений Avito и Cian через реальные переходы в отдельной вкладке и отправляет их на локальный сервер сбора.",
  "permissions": ["tabs", "scripting", "storage", "alarms", "webNavigation"],
  "host_permissions": [
    "https://www.avito.ru/*",
    "https://www.cian.ru/*",
    "http://127.0.0.1:8765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "MoscowFlatCollector"
  }
}
